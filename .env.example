# Postgres connection string (Vercel Storage / Neon / etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Session encryption key - random string, at least 32 characters.
SESSION_SECRET="replace-with-a-long-random-string-min-32-chars"

# ZenHR OAuth application (create at <your-zenhr-login-domain>/en/oauth/applications)
ZENHR_BASE_URL="app.zenhr.com"
ZENHR_PROTOCOL="https"
ZENHR_CLIENT_ID=""
ZENHR_CLIENT_SECRET=""
ZENHR_REDIRECT_URI="https://YOUR-DEPLOYED-DOMAIN/api/auth/zenhr/callback"
ZENHR_SCOPES="read:employee read:branch read:attendance_record"

# Bricks (BricksRep) visits API
BRICKS_API_KEY=""

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>"
CRON_SECRET="replace-with-a-long-random-string"

# One-time admin account created by `npm run seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
