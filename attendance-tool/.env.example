# ---- Database ----
# Pooled connection for the app. A Vercel/Neon integration may instead
# provide POSTGRES_PRISMA_URL or POSTGRES_URL - either is picked up
# automatically, so there is nothing to rename.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (unpooled) connection, used for migrations. Neon's integration
# provides this as DATABASE_URL_UNPOOLED, which is also recognised.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- App ----
# Session cookie encryption. Random, at least 32 characters.
SESSION_SECRET="replace-with-a-long-random-string-min-32-chars"
# Shared passphrase for the HR team to sign in with.
APP_PASSWORD="replace-me"

# ---- ZenHR ----
ZENHR_BASE_URL="app.zenhr.com"
ZENHR_PROTOCOL="https"

# Pick ONE way to authenticate. The first three involve no browser step at
# all; what each may write is decided by its scopes or, for an API key, the
# Read/Write/Update ticks on the key itself.
#
# 1. API key - Integration Setup > API Keys. Preferred: no redirect, and
#    write access is an explicit tick rather than a scope negotiation.
ZENHR_API_KEY=""
ZENHR_API_SECRET=""
#
# 2. A refresh token from ZenHR's "Manage Tokens" screen. Also no redirect;
#    the tool renews its own access tokens from this indefinitely.
ZENHR_REFRESH_TOKEN=""
#
# 3. An access token pasted directly. Simplest, but expires.
ZENHR_ACCESS_TOKEN=""
#
# 4. Fall back to the one-time browser authorisation at /admin/connect-zenhr.
#    Only used when none of the above are set.
ZENHR_CLIENT_ID=""
ZENHR_CLIENT_SECRET=""

# Only if this ZenHR account expects the credential somewhere other than
# "Authorization: Bearer <token>".
# ZENHR_AUTH_HEADER="Authorization"
# ZENHR_AUTH_SCHEME="Bearer"
ZENHR_REDIRECT_URI="https://YOUR-VERCEL-DOMAIN/api/auth/zenhr/callback"
# Reading attendance and time off, and creating the deduction transactions.
# ZenHR uses read:/create:/update:, never "write:". Leave unset to use the
# list the code requires.
ZENHR_SCOPES="read:employee read:branch read:attendance_record read:timeoff read:timeoff_transaction read:timeoff_transaction_request read:employee_shift read:work_shift timeoff_balances:employee create:timeoff_transaction_request"
# Optional: pin the branch instead of taking the account's first one.
ZENHR_BRANCH_ID=""

# ---- Bricks (BricksRep visits) ----
BRICKS_API_KEY=""
BRICKS_BASE_URL="https://fullstock.bricks-rep.com"
