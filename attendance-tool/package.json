{
  "name": "fullstock-attendance-tool",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "node scripts/with-db-env.mjs next dev -p 3001",
    "build": "prisma generate && node scripts/with-db-env.mjs \"prisma migrate deploy && tsx scripts/seed.ts\" && next build",
    "start": "node scripts/with-db-env.mjs next start",
    "seed": "node scripts/with-db-env.mjs tsx scripts/seed.ts",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate:deploy": "node scripts/with-db-env.mjs prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "date-fns": "^3.6.0",
    "iron-session": "^8.0.3",
    "next": "15.5.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "prisma": "^5.20.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
