# Postgres connection string
DATABASE_URL="postgresql+psycopg://user:password@host:5432/fullstock_hr"

# JWT signing secret - random string, at least 32 characters
JWT_SECRET="replace-with-a-long-random-string-min-32-chars"

# Shared secret required in the "Authorization: Bearer <value>" header
# for the scheduled-sync trigger endpoint.
SYNC_CRON_SECRET="replace-with-a-long-random-string"

# ZenHR OAuth application (create at <your-zenhr-login-domain>/en/oauth/applications)
ZENHR_BASE_URL="app.zenhr.com"
ZENHR_CLIENT_ID=""
ZENHR_CLIENT_SECRET=""
ZENHR_REDIRECT_URI="https://YOUR-DEPLOYED-DOMAIN/api/sync/zenhr/callback"

# Bricks (BricksRep) visits API
BRICKS_BASE_URL="https://fullstock.bricks-rep.com"
BRICKS_API_KEY=""

# Origin the frontend is served from, for CORS
FRONTEND_ORIGIN="http://localhost:5173"

# Auth cookie flags. Local dev over plain HTTP: leave as below. A real
# deploy with the frontend on a different domain (e.g. Vercel + Railway)
# needs COOKIE_SECURE=true and COOKIE_SAMESITE=none, or the browser won't
# send the cookie cross-site.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# One-time admin account created by `python -m app.seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Admin"
